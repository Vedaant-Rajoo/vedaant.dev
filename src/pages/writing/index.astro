---
import { getCollection, getEntry } from 'astro:content';
import Chip from '../../components/Chip.astro';
import Row from '../../components/Row.astro';
import { dayMonth, fullDay, initials } from '../../data/format';
import { words } from '../../data/navigation';
import { intro, pieces } from '../../data/writing';
import Base from '../../layouts/Base.astro';

// Astro only logs a missing reference. Check drafts too; this is validation, never a display list.
for (const piece of await getCollection('writing')) {
  if (piece.data.project && !(await getEntry(piece.data.project))) {
    throw new Error(
      `${piece.filePath}: writing "${piece.id}" references missing project "${piece.data.project.id}"`,
    );
  }
}
const all = await pieces();
const groups = Map.groupBy(all, ({ data }) => data.published.slice(0, 4));
// The line the 404 page shows for this page (navigation.ts) is its description.
const [{ sub }] = words.filter(({ href }) => href === '/writing');
---

<Base title="writing" description={sub} class="max-w-col">
  <h1 class="text-2xl font-semibold">
    writing <span class="meta text-base font-normal text-fg-3">{all.length}</span>
  </h1>
  <p class="mt-3 text-fg-2">
    {intro} <a href="/feed.xml" class="link">rss</a>
  </p>
  <div class="flex flex-col gap-6">
    {
      [...groups].map(([year, group]) => (
        <section class="flex flex-col gap-6">
          <h2 id={`year-${year}`} class="meta border-t border-dashed border-line pt-6 text-xs text-fg-3">
            <time>{year}</time>
          </h2>
          {/* biome-ignore lint/a11y/noRedundantRoles: Safari drops list semantics when list-style is none. */}
          <ol role="list" aria-labelledby={`year-${year}`} class="divide-y divide-line wrap-anywhere">
            {group.map(({ id, data }) => {
              return (
                <li>
                  <Row tile={initials(data.title)} title={data.title} sub={data.summary} href={`/writing/${id}`}>
                    <Fragment slot="chips">{data.kind === 'note' && <>{' '}<Chip label="note" /></>}</Fragment>
                    <abbr title={fullDay(data.published)} class="no-underline whitespace-nowrap">
                      <time datetime={data.published}>{dayMonth(data.published)}</time>
                    </abbr>
                  </Row>
                </li>
              );
            })}
          </ol>
        </section>
      ))
    }
  </div>
</Base>

<style>
  h1 {
    margin-block-start: var(--sp-section);
  }
  h1 + p {
    margin-block-end: var(--sp-section);
  }
</style>
