---
import { month, monthYear } from '../data/format';
import Arrow from './Arrow.astro';

interface Props {
  tile: string;
  title: string;
  sub: string;
  start?: string;
  end?: string | null;
  href?: string;
  toggle?: boolean;
  struck?: boolean;
  note?: string;
  links?: { label: string; href: string }[];
}

const { tile, title, sub, start, end, href, toggle = false, struck = false, note, links = [] } =
  Astro.props;
// Links do not nest: with links of its own in the right cell, a row is not one <a>. Its text is
// the link instead, and the text's ::after covers the row as its target and its focus ring. A link
// to the row's own href is no second link but its label, "repo ↗" or "case study →", in place of
// the ↗ after the title.
const split = href !== undefined && links.some((link) => link.href !== href);
const labelled = links.some((link) => link.href === href);
const Tag = (toggle && 'summary') || (href && !split && 'a') || 'div';
const Text = split ? 'a' : 'span';
const hasChips = Astro.slots.has('chips');
---

{/* One list row: a tile, the title and its sub line, which ends in the chips slot (each chip
    after a space), then the paired
    dates, if any, the default slot, the note and the links. These move under the text when the
    text would get less than 6rem beside them, or 12rem beside a note or links, room for the
    widest chip. Spans only, so the row can be a <summary>. A null end is a current role: the live
    dot, "now", not muted; an ended role is muted; a row without dates is neither. A struck row, an
    archived project, is muted and its title struck through. Every row overhangs the
    column by 8px, so a link's or a toggle's hover fill clears the text. Dates above a note
    or links take a line of their own. A word too long for its line breaks rather than widen
    the page, as in Now's and Writing's lists. */}
<Tag
  href={split ? undefined : href}
  class:list={[
    '-mx-2 flex flex-wrap items-center gap-3 rounded-sm px-2 py-1.5',
    (end || struck) && 'text-fg-2',
    (href || toggle) && 'transition-colors duration-(--d-2) hover:bg-surface',
    toggle && 'cursor-pointer',
    split && 'relative',
  ]}
>
  <span
    aria-hidden="true"
    class="relative flex size-8 shrink-0 items-center justify-center rounded-sm bg-sunken font-mono text-xs"
  >
    {tile}
    {
      end === null && (
        <span class="absolute -top-0.5 -right-0.5 size-1.75 rounded-(--r-pill) bg-live outline-2 outline-bg" />
      )
    }
  </span>
  <Text
    href={split ? href : undefined}
    class:list={[
      'min-w-0 grow wrap-anywhere',
      note || links.length > 0 ? 'basis-48' : 'basis-24',
      'leading-(--lh-snug) text-pretty',
      split &&
        'after:absolute after:inset-0 after:rounded-sm focus-visible:outline-none focus-visible:after:outline-2 focus-visible:after:outline-offset-2 focus-visible:after:outline-focus',
    ]}
  >
    <span class:list={['font-medium', struck && 'line-through']}>{title}</span>{href?.startsWith('https://') && !labelled && <> <Arrow>↗</Arrow></>}{' '}
    <span class:list={['text-sm leading-(--lh-snug) text-fg-2', hasChips ? 'mt-0.5 block' : 'inline-block']}>{!hasChips && '· '}{sub}{hasChips && <slot name="chips" />}</span>
  </Text>
  <span class="meta ml-auto text-right text-xs text-fg-3">
    {
      start && (
        <abbr title={`${month(start)} – ${end ? month(end) : 'Present'}`} class:list={['no-underline whitespace-nowrap', (note || links.length > 0) && 'mb-1 block']}>
          <time datetime={start}>{monthYear(start)}</time> –{' '}
          {end ? <time datetime={end}>{monthYear(end)}</time> : 'now'}
        </abbr>
      )
    }
    <slot />
    {note}
    {
      links.map((link, i) => (
        <>
          {(i > 0 || note) && ' · '}
          {
            link.href === href ? (
              <span>{link.label} <Arrow>{link.href.startsWith('https://') ? '↗' : '→'}</Arrow></span>
            ) : (
              <a
                href={link.href}
                class="target link relative -my-2.5 justify-end"
              >
                <span>
                  {link.label}
                  {link.href.startsWith('https://') && <> <Arrow>↗</Arrow></>}
                </span>
              </a>
            )
          }
        </>
      ))
    }
  </span>
</Tag>

<style>
  /* Safari draws its own disclosure triangle on a <summary>, whatever its display. */
  summary::-webkit-details-marker {
    display: none;
  }
</style>
