---
import { getCollection } from 'astro:content';
import { initials } from '../data/format';
import { newestFirst, rowHref } from '../data/projects';
import Chip from './Chip.astro';
import Row from './Row.astro';
import SectionLabel from './SectionLabel.astro';

const projects = await getCollection('projects');
// The four newest featured rows; archived projects never show here, and the rest wait on /projects.
const rows = projects
  .filter(({ data }) => data.featured && data.status !== 'archived')
  .sort(newestFirst)
  .slice(0, 4)
  .map((project) => ({ data: project.data, href: rowHref(project) }));
---

<section class="flex flex-col gap-6">
  <SectionLabel label="projects" count={projects.length} href="/projects" />
  {/* biome-ignore lint/a11y/noRedundantRoles: Safari drops list semantics when list-style is none. */}
  <ol role="list" class="divide-y divide-line">
    {
      rows.map(({ data, href }) => (
        <li>
          <Row tile={initials(data.title)} title={data.title} sub={data.summary} href={href}>
            <Fragment slot="chips">
              {data.stack.map((name) => (
                <>
                  {' '}
                  <Chip label={name} />
                </>
              ))}
            </Fragment>
            <time>{data.year}</time>
          </Row>
        </li>
      ))
    }
  </ol>
</section>

<style>
  section {
    margin-block-start: var(--sp-section);
  }
</style>
