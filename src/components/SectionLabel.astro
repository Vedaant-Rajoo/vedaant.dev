---
import Arrow from './Arrow.astro';

interface Props {
  label: string;
  count?: number;
  href?: string;
  word?: string;
}

const { label, count, href, word = 'all' } = Astro.props;
---

<div class="flex items-baseline justify-between gap-3 border-t border-dashed border-line pt-6">
  <h2 class="meta text-xs text-fg-3">{label}{count !== undefined && ` ${count}`}</h2>
  {
    href && (
      <a
        href={href}
        class="meta target link -my-3.5 justify-end text-xs text-fg-3"
      >
        <span>{word} <Arrow>→</Arrow></span>
      </a>
    )
  }
</div>
