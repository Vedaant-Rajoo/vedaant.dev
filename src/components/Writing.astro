---
import { fullDay, initials, monthYear } from '../data/format';
import { pieces } from '../data/writing';
import Chip from './Chip.astro';
import Row from './Row.astro';
import SectionLabel from './SectionLabel.astro';

const all = await pieces();
---

{/* The two newest pieces, counted all; with none the section is left out. The date is "Mon ’YY"
    in an <abbr> with the whole day, as Row writes its months.
    Every row passes the chips slot, so posts and notes share Row's stacked layout; only
    a note fills it. wrap-anywhere breaks a word too long for the row, such as a long identifier. */}
{
  all.length > 0 && (
    <section class="flex flex-col gap-6">
      <SectionLabel label="writing" count={all.length} href="/writing" />
      {/* biome-ignore lint/a11y/noRedundantRoles: Safari drops list semantics when list-style is none. */}
      <ol role="list" class="divide-y divide-line wrap-anywhere">
        {all.slice(0, 2).map(({ id, data }) => {
          return (
            <li>
              <Row tile={initials(data.title)} title={data.title} sub={data.summary} href={`/writing/${id}`}>
                <Fragment slot="chips">{data.kind === 'note' && <>{' '}<Chip label="note" /></>}</Fragment>
                <abbr title={fullDay(data.published)} class="no-underline whitespace-nowrap">
                  <time datetime={data.published}>{monthYear(data.published)}</time>
                </abbr>
              </Row>
            </li>
          );
        })}
      </ol>
    </section>
  )
}

<style>
  section {
    margin-block-start: var(--sp-section);
  }
</style>
