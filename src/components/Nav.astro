---
import { words } from '../data/navigation';
import { site } from '../data/site';
import Clock from './Clock.astro';

const path = Astro.url.pathname;
---

<header class="flex flex-wrap items-center justify-between gap-x-1 gap-y-2 pt-5 sm:gap-x-6">
  <a href="/" class="flex min-h-11 min-w-11 items-center font-medium">{site.name}</a>
  <nav aria-label="Site" class="flex flex-wrap gap-y-2 text-sm sm:gap-x-2">
    {
      words.map(({ word, href }) => {
        const current = path === href || path.startsWith(`${href}/`);
        return (
          <a
            href={href}
            aria-current={current ? 'page' : undefined}
            class:list={[
              'flex min-h-11 min-w-11 items-center justify-center px-1.5 transition-colors',
              current ? 'text-fg' : 'text-fg-2 hover:text-fg',
            ]}
          >
            {word}
          </a>
        );
      })
    }
    <Clock />
  </nav>
</header>
