---
import { resumeMonth, site } from '../data/site';

// No props: an attribute passed to Hero fails the type check (the S8b → S8c rule).
type Props = Record<string, never>;

// The serif word (FR-HE-3): hero.accent where it first appears in hero.role (site.ts checks it does).
const { role, accent = '', mark } = site.hero;
const at = accent ? role.indexOf(accent) : -1;
const markedAt = role.indexOf(mark);
const parts = [[0, markedAt], [markedAt, markedAt + mark.length], [markedAt + mark.length, role.length]];
// The labels are the interface's (D38); the lines are the owner's, in site.json.
const lines = [
  ['today', site.hero.today],
  ['previously', site.hero.previously],
];
const link = 'underline decoration-line-2 transition-colors hover:decoration-fg';
// The footer's 44px box (D40). The email link keeps the footer's shape, so its script copies here too.
const box = `flex min-h-11 min-w-11 items-center justify-center px-1.5 ${link}`;
---

<section class="flex flex-col gap-4">
  <h1 class="text-3xl font-semibold">{site.hero.name}</h1>
  <p class="text-lg">
    {
      parts.map(([start, end], index) => {
        const Tag = index === 1 ? 'mark' : 'span';
        return (
          <Tag>{at >= start && at + accent.length <= end ? (
            <>{role.slice(start, at)}<span class="accent">{accent}</span>{role.slice(at + accent.length, end)}</>
          ) : role.slice(start, end)}</Tag>
        );
      })
    }
  </p>
  {/* A line moves under its label when large text leaves it less than 11rem beside it. */}
  <dl class="flex flex-col gap-1.5">
    {
      lines.map(([label, text]) => (
        <div class="flex flex-wrap items-baseline gap-x-1">
          <dt class="meta w-24 shrink-0 text-xs text-fg-3">{label}</dt>
          <dd class="min-w-0 grow basis-44 leading-(--lh-snug)">{text}</dd>
        </div>
      ))
    }
  </dl>
  <p class="-mx-1.5 flex flex-wrap gap-2 text-sm">
    <a href="/resume.pdf" class={box}>
      <span>resume · <time datetime={site.resume.updated} class="text-xs">{resumeMonth}</time> <span aria-hidden="true" class="inline-block font-sans">↗</span></span>
    </a>
    <a href={`mailto:${site.email}`} class={box} data-copy>
      <span>email <span aria-hidden="true" class="inline-block font-sans">→</span></span>
    </a>
    <a href={site.socials.github} rel="me" class={box}>
      <span>github <span aria-hidden="true" class="inline-block font-sans">↗</span></span>
    </a>
  </p>
</section>

<style>
  section {
    margin-block-start: var(--sp-section);
  }
  /* The serif's only face is its sloped one, which an upright word still matches: the word slopes
     in the serif and stays upright in the sans fallback, "plain sans" when the font is late. */
  .accent {
    font-family: var(--ff-serif);
  }
</style>
