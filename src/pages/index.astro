---
import Hero from '../components/Hero.astro';
import Now from '../components/Now.astro';
import Projects from '../components/Projects.astro';
import Work from '../components/Work.astro';
import Writing from '../components/Writing.astro';
import { site } from '../data/site';
import Base from '../layouts/Base.astro';
---

{/* The title is the full name alone; the description is the role line, which the OG image also
    shows (p18). */}
<Base
  description={site.hero.role}
  class="max-w-col"
  schema={{ '@type': 'Person', name: site.fullName, sameAs: Object.values(site.socials) }}
>
  <Hero />
  <Work />
  <Projects />
  <Now />
  <Writing />
</Base>
