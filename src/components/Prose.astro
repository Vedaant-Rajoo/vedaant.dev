---
// The body is the slot, and nothing else may be passed (the S8b → S8c rule).
interface Props {
  children: unknown;
}
---

{/* A Markdown body (p13, p15): global.css styles it under .prose, because the rendered elements
    carry no classes. The empty polite region after it announces a copy (below); it is in the HTML
    from the start, because a screen reader registers a live region most reliably that way. */}
<div class="prose"><slot /></div>
<span class="sr-only" aria-live="polite"></span>

<script>
  // FR-WR-3: a copy button on each code block, added here, so without JS the block is a plain
  // <pre>. It copies the <code>'s text exactly, reads "copied" or "failed" for 1.5 s, and the first
  // Prose's region announces the result. A browser without the Clipboard API, or one that does not
  // keep the button's room free (global.css), gets no button: the code stays selectable.
  const blocks = document.querySelectorAll<HTMLPreElement>('.prose pre');
  const status = document.querySelector<HTMLElement>('.prose + [aria-live]');
  if (
    status &&
    blocks.length > 0 &&
    navigator.clipboard &&
    matchMedia('(scripting: enabled)').matches
  ) {
    // The page's latest click owns the region; each button shows its own latest result.
    let latest = 0;
    let announcer: HTMLButtonElement | undefined;
    for (const pre of blocks) {
      const button = document.createElement('button');
      button.type = 'button';
      // At rest the visible mark is a copy glyph, hidden from the name (as the footer's arrows
      // are). "copied" and "failed" are the words on screen, and the name holds them (WCAG 2.5.3).
      const label = (text: string) => {
        if (text === 'copy') {
          button.replaceChildren();
          const mark = document.createElement('span');
          mark.setAttribute('aria-hidden', 'true');
          mark.textContent = '⧉';
          button.append(mark);
          button.setAttribute('aria-label', 'Copy code');
        } else {
          button.textContent = text;
          button.setAttribute('aria-label', `Copy code, ${text}`);
        }
      };
      label('copy');
      // The box goes before the <pre>, which is not moved, so a block already focused or scrolled
      // keeps its focus and scroll.
      const box = document.createElement('div');
      box.className = 'code';
      box.append(button);
      pre.before(box);
      let clicks = 0;
      let timer: ReturnType<typeof setTimeout> | undefined;
      // A result shows on its button unless a later click there is pending, and is announced unless
      // a later click anywhere is. The label returns 1.5 s after it.
      const show = (click: number, request: number, text: string, message: string) => {
        if (click !== clicks) {
          return;
        }
        label(text);
        if (request === latest) {
          status.textContent = message;
          announcer = button;
        }
        clearTimeout(timer);
        timer = setTimeout(() => {
          if (click !== clicks) {
            return;
          }
          label('copy');
          // One region serves every button: only the one that wrote it last empties it.
          if (announcer === button) {
            status.textContent = '';
          }
        }, 1500);
      };
      button.addEventListener('click', () => {
        const click = ++clicks;
        const request = ++latest;
        // Emptied now and filled when the write settles, so the same result twice is heard twice.
        status.textContent = '';
        navigator.clipboard.writeText((pre.querySelector('code') ?? pre).textContent ?? '').then(
          () => show(click, request, 'copied', 'copied'),
          () => show(click, request, 'failed', 'copy failed'),
        );
      });
    }
  }
</script>
