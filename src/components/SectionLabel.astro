---
import Arrow from './Arrow.astro';

interface Props {
  // The heading's text; a slot in its place may hold markup, such as a year's <time>.
  label?: string;
  count?: number;
  href?: string;
  word?: string;
  // For a list's aria-labelledby.
  id?: string;
}

const { label, count, href, word = 'all', id } = Astro.props;
---

<div class="flex items-baseline justify-between gap-3 border-t border-dashed border-line pt-6">
  <h2 id={id} class="meta text-xs text-fg-3"><slot>{label}</slot>{count !== undefined && ` ${count}`}</h2>
  {
    href && (
      <a
        href={href}
        class="meta target link -my-3.5 justify-end text-xs text-fg-3"
      >
        <span>{word}<Arrow>→</Arrow></span>
      </a>
    )
  }
</div>
