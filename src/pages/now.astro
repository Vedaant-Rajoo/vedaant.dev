---
import Arrow from '../components/Arrow.astro';
import Coding from '../components/Coding.astro';
import Heatmap from '../components/Heatmap.astro';
import NowPlaying from '../components/NowPlaying.astro';
import ShelfCell from '../components/ShelfCell.astro';
import { day } from '../data/format';
import { nowEntry } from '../data/now';
import { site } from '../data/site';
import Base from '../layouts/Base.astro';

const now = await nowEntry();
const { updated, summary } = now.data;
// The body is "## label" sections; each label is a <dt> and the paragraphs under it its <dd>.
// now.test.ts checks the file's shape. Comments are dropped first; a section with no text is left out.
const [, ...parts] = (now.rendered?.html ?? '')
  .replace(/<!--[\s\S]*?-->/g, '')
  .split(/<h2 id="[^"]*">([^<]*)<\/h2>/);
const sections = Array.from({ length: parts.length / 2 }, (_, i) => ({
  label: parts[2 * i],
  html: parts[2 * i + 1].trim(),
})).filter(({ html }) => html.replace(/<[^>]*>/g, '').trim() !== '');

// "Older than 60 days", in whole days at build. updated is midnight UTC, so the note
// shows from the 61st day after it, and never for a day in the future.
const stale = Math.floor((Date.now() - Date.parse(updated)) / 86_400_000) > 60;
---

<Base title="now" description={summary} class="max-w-wide">
  <header class="flex max-w-col flex-col gap-3">
    <h1 class="text-2xl font-semibold">now</h1>
    {/* Links in this line keep its height (WCAG 2.5.8's inline exception), as in the footer's. */}
    <p class="meta text-xs text-fg-3">
      updated <time datetime={updated} class="whitespace-nowrap">{day(updated)}</time>{stale && ' (it has been a while)'} · <a href={site.history} class="link">history<Arrow>↗</Arrow></a> · <a href="/uses" class="link">how I work<Arrow>→</Arrow></a>
    </p>
    <p class="text-fg-2">{summary}</p>
  </header>
  <dl class="labels">
    {
      sections.map(({ label, html }) => (
        <>
          <dt set:html={label} />
          <dd set:html={html} />
        </>
      ))
    }
  </dl>
  <section class="flex flex-col gap-4">
    <p class="meta text-xs text-fg-3">music live · coding, contributions and shelf daily · each keeps its last value</p>
    <div class="bento grid gap-3">
      <NowPlaying />
      <Coding />
      <Heatmap />
      <ShelfCell kind="last-watched" />
      <ShelfCell kind="reading" />
    </div>
  </section>
</Base>

<style>
  .bento {
    grid-template-columns: repeat(auto-fit, minmax(min(calc(var(--sp-unit) * 80), 100%), 1fr));
  }
  /* The sections in the label column (global.css), in 65ch inside a 40rem column. */
  dl {
    max-width: min(var(--w-col), var(--w-measure));
  }
  dd :global(p + p) {
    margin-block-start: var(--sp-row);
  }
</style>
