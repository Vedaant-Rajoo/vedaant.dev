---
import { built as parts, site } from '../data/site';

// HH:MM in the owner's zone at build time; with JS off a page shows when it was built.
// theme.ts repeats this format each minute in the browser, from data-zone: change both together.
const time = `${parts.hour}:${parts.minute}`;
// longOffset reads "GMT+05:30"; if an ICU prints a zero offset as bare "GMT", keep "+00:00".
const offset = parts.timeZoneName.slice(3) || '+00:00';
const datetime = `${parts.year}-${parts.month}-${parts.day}T${time}${offset}`;
---

<noscript><time datetime={datetime} class="flex min-h-11 items-center px-1.5">{time}</time></noscript>
<button
  id="theme-toggle"
  type="button"
  class="flex min-h-11 cursor-pointer items-center gap-2 px-1.5 font-mono transition-colors hover:text-fg-2"
>
  <time datetime={datetime} data-zone={site.timeZone}>{time}</time>
</button>
<script src="../scripts/theme.ts"></script>

<style>
  /* ◐ system, ☀ light, ☾ dark, from the head script's data-theme-pref; \FE0E asks for the text
     form of ☀, which some systems draw as an emoji. */
  button::after {
    content: "◐";
  }
  :global([data-theme-pref="light"]) button::after {
    content: "☀\FE0E";
  }
  :global([data-theme-pref="dark"]) button::after {
    content: "☾";
  }
</style>
