---
import { resumeMonth, site } from '../data/site';
import Arrow from './Arrow.astro';
import Presence from './Presence.astro';

const { role, accent = '', mark } = site.hero;
const at = accent ? role.indexOf(accent) : -1;
const markedAt = role.indexOf(mark);
const parts = [[0, markedAt], [markedAt, markedAt + mark.length], [markedAt + mark.length, role.length]];
---

<section class="flex flex-col gap-4">
  <h1 class="text-3xl font-semibold">{site.hero.name}</h1>
  <p class="text-lg">
    {
      parts.map(([start, end], index) => {
        const Tag = index === 1 ? 'mark' : 'span';
        return (
          <Tag>{at >= start && at + accent.length <= end ? (
            <>{role.slice(start, at)}<span class="accent">{accent}</span>{role.slice(at + accent.length, end)}</>
          ) : role.slice(start, end)}</Tag>
        );
      })
    }
  </p>
  {/* The presence text fills the row's fixed share, so a live change never moves the link (CLS 0). */}
  <div class="flex items-center gap-3">
    <div class="min-w-0 flex-1"><Presence /></div>
    <a href="/now" class="meta target link -my-3.5 shrink-0 justify-end text-sm text-fg-3">
      <span>now <Arrow>→</Arrow></span>
    </a>
  </div>
  {/* The email link copies, as the footer's does. */}
  <p class="flex flex-wrap items-center gap-x-4">
    <span>{site.hero.today}</span>
    <span class="-mx-1.5 flex flex-wrap gap-2">
      <a href="/resume.pdf" class="box">
        <span>résumé · <time datetime={site.resume.updated} class="text-xs">{resumeMonth}</time> <Arrow>↗</Arrow></span>
      </a>
      <a href={`mailto:${site.email}`} class="box" data-copy>
        <span>email <Arrow>→</Arrow></span>
      </a>
      <a href="/uses" class="box">
        <span>how I work <Arrow>→</Arrow></span>
      </a>
    </span>
  </p>
</section>

<style>
  section {
    margin-block-start: var(--sp-section);
  }
  /* The serif's only face is its sloped one, which an upright word still matches: the word slopes
     in the serif and stays upright in the sans fallback, "plain sans" when the font is late. */
  .accent {
    font-family: var(--ff-serif);
  }
</style>
