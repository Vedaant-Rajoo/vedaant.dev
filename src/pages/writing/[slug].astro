---
import { getEntry, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Arrow from '../../components/Arrow.astro';
import Chip from '../../components/Chip.astro';
import Prose from '../../components/Prose.astro';
import Row from '../../components/Row.astro';
import { day, initials } from '../../data/format';
import { rowHref } from '../../data/projects';
import { site } from '../../data/site';
import { pieces } from '../../data/writing';
import Base from '../../layouts/Base.astro';

export const getStaticPaths = (async () => {
  const all = await pieces();
  return all.map((piece, i) => ({
    params: { slug: piece.id },
    props: { piece, previous: all[i + 1], next: all[i - 1] },
  }));
}) satisfies GetStaticPaths;

const { piece, previous, next } = Astro.props;
const { data } = piece;
// Match the case-study page's one-h1 guard, including raw HTML but excluding comments and code.
if (/<h1[\s/>]/i.test((piece.rendered?.html ?? '').replace(/<!--[\s\S]*?-->/g, ''))) {
  throw new Error(`${piece.filePath}: the body has an h1; start its headings at ##`);
}
// writing/index.astro fails the build on a missing project.
const project = data.project && (await getEntry(data.project));
const { Content } = await render(piece);
// shortcut: English Markdown whitespace tokens, including markup/code. If rich content or
// another writing system needs a visible-text count, count parsed rendered text instead.
const minutes = Math.max(1, Math.ceil((piece.body ?? '').split(/\s+/).filter(Boolean).length / 200));
const link = 'target link flex-1 basis-48';
---

<Base
  title={data.title}
  description={data.summary}
  class="max-w-col"
  schema={{
    '@type': 'Article',
    headline: data.title,
    description: data.summary,
    datePublished: data.published,
    // As the meta line: only an update after the day it was published.
    dateModified: data.updated && data.updated > data.published ? data.updated : undefined,
    author: { '@type': 'Person', name: site.fullName, url: Astro.site?.href },
  }}
>
  <article class="writing-post wrap-anywhere">
    <header class="flex flex-col gap-3">
      <h1 class="text-2xl font-semibold">{data.title}</h1>
      <p class="meta text-xs text-fg-3">
        {data.kind} · <time datetime={data.published} class="whitespace-nowrap">{day(data.published)}</time> · <span class="whitespace-nowrap">{minutes} min read</span>
        {
          data.updated && data.updated > data.published && (
            <> · updated <time datetime={data.updated} class="whitespace-nowrap">{day(data.updated)}</time></>
          )
        }
      </p>
    </header>
    <Prose><Content /></Prose>
    {
      project && (
        <section aria-label="Related project" class="related border-t border-line pt-6">
          <Row
            tile={initials(project.data.title)}
            title={project.data.title}
            sub={project.data.summary}
            href={rowHref(project)}
            struck={project.data.status === 'archived'}
            note={project.data.confidential ? 'no repo · confidential' : undefined}
          >
            <Fragment slot="chips">{project.data.stack.map((name) => <>{' '}<Chip label={name} /></>)}</Fragment>
            <time>{project.data.year}</time>
            {project.data.status === 'archived' && <span class="sr-only">archived</span>}
          </Row>
        </section>
      )
    }
    {
      (previous || next) && (
        <nav aria-label="Other writing" class="piece-links meta flex flex-wrap gap-2 border-t border-line pt-6 text-sm">
          {previous && (
            <a href={`/writing/${previous.id}`} class={link}>
              <span><Arrow>←</Arrow> {previous.data.title}</span>
            </a>
          )}
          {next && (
            <a href={`/writing/${next.id}`} class={`${link} justify-end text-right`}>
              <span>{next.data.title} <Arrow>→</Arrow></span>
            </a>
          )}
        </nav>
      )
    }
  </article>
</Base>

<style>
  header {
    margin-block: var(--sp-section);
  }
  .related,
  .piece-links {
    margin-block-start: var(--sp-section);
  }
  /* shortcut: internal links are root-relative; absolute web links are outbound. If
     absolute internal URLs are needed, classify against the configured site origin instead. */
  .writing-post :global(.prose a:is([href^="https://"], [href^="http://"], [href^="//"]))::after {
    content: ' ↗' / '';
    font-family: var(--ff-sans);
  }
</style>
