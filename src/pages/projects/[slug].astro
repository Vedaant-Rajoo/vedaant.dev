---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Arrow from '../../components/Arrow.astro';
import Chip from '../../components/Chip.astro';
import Prose from '../../components/Prose.astro';
import { day } from '../../data/format';
import { hasCaseStudy } from '../../data/projects';
import Base from '../../layouts/Base.astro';

// One page per row that links a case study: rowHref reads the same predicate, so a draft gets a
// page only in `astro dev`. Outside a draft, a case study needs its published date.
export const getStaticPaths = (async () =>
  (await getCollection('projects', hasCaseStudy)).map((project) => {
    if (!project.data.draft && project.data.published === undefined) {
      throw new Error(`${project.filePath}: a case study needs a published date`);
    }
    return { params: { slug: project.id }, props: { project } };
  })) satisfies GetStaticPaths;

const { project } = Astro.props;
const { data } = project;
// The title is the page's one h1. The rendered body is checked, so raw HTML counts too,
// <h1/> included, which browsers open as an h1; an h1 in a code fence (escaped) or in an HTML
// comment does not.
if (/<h1[\s/>]/i.test((project.rendered?.html ?? '').replace(/<!--[\s\S]*?-->/g, ''))) {
  throw new Error(`${project.filePath}: the body has an h1; start its headings at ##`);
}
const { Content } = await render(project);
// Confidential work keeps its case study, but its links give way to the note.
const links = data.confidential
  ? []
  : [
      data.repo ? { label: 'repo', href: data.repo } : undefined,
      data.prs ? { label: 'my PRs', href: data.prs } : undefined,
    ].filter((link) => link !== undefined);
// In the wrapping meta line the 44px boxes keep their height, so wrapped rows stay 8px apart. A
// back link, alone on its line, is held to the text's height as SectionLabel's is; its box then
// reaches 14px past the text, which the gaps around it leave free.
const back = 'target link -my-3.5';
---

<Base title={data.title} description={data.summary} class="max-w-col">
  <header class="flex flex-col gap-3.5">
    <p class="meta text-xs text-fg-3">
      <a href="/projects" class={back}>
        <span><Arrow>←</Arrow> projects</span>
      </a>
    </p>
    <h1 class="text-2xl font-semibold">{data.title}</h1>
    <p class="text-lg">{data.summary}</p>
    <p class="meta flex flex-wrap items-center gap-x-3 gap-y-2 text-xs text-fg-3">
      <time>{data.year}</time>
      {data.stack.length > 0 && <span>·</span>}
      {data.stack.map((name) => <Chip label={name} />)}
      {
        links.map(({ label, href }) => (
          <>
            <span>·</span>
            <a href={href} class="target link">
              <span>
                {label} <Arrow>↗</Arrow>
              </span>
            </a>
          </>
        ))
      }
      {
        data.confidential && (
          <>
            <span>·</span>
            <span>no repo · confidential</span>
          </>
        )
      }
      <span>·</span>
      <span>status: {data.status}</span>
    </p>
  </header>
  <Prose><Content /></Prose>
  <footer class="flex flex-wrap justify-between gap-x-3 gap-y-3.5 border-t border-line pt-6">
    <p class="meta text-xs text-fg-3">
      <a href="/projects" class={back}>
        <span><Arrow>←</Arrow> all projects</span>
      </a>
    </p>
    {
      data.published && (
        <p class="meta text-xs text-fg-3">
          published <time datetime={data.published} class="whitespace-nowrap">{day(data.published)}</time>
          {data.updated && (
            <>
              {' '}
              · updated <time datetime={data.updated} class="whitespace-nowrap">{day(data.updated)}</time>
            </>
          )}
        </p>
      )
    }
  </footer>
</Base>

<style>
  header {
    margin-block: var(--sp-section);
  }
  footer {
    margin-block-start: var(--sp-section);
  }
</style>
