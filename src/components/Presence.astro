---
import { nowPlaying } from '../data/lastfm';
import { nowEntry } from '../data/now';
import { type NowPlaying, presenceState, presenceText } from '../data/now-playing';

interface Props {
  value?: NowPlaying;
  state?: NowPlaying['state'] | 'offline' | 'loading';
}

const { from } = (await nowEntry()).data;
const { value = nowPlaying } = Astro.props;
const given = Astro.props.state ?? (value.state === 'empty' ? 'empty' : 'idle');
// A loading fixture stays loading only while it has no track to show.
const loading = given === 'loading' && !value.track?.trim();
const state = loading ? 'loading' : presenceState(given === 'loading' ? 'idle' : given, value);
const text = presenceText(state, value);
---

<p
  data-widget="presence"
  data-state={state}
  data-fixture={Astro.props.value || Astro.props.state ? '' : undefined}
  aria-live="off"
  aria-busy={state === 'loading' ? 'true' : 'false'}
  class="meta min-h-4 min-w-0 truncate text-sm font-medium leading-(--lh-snug) text-fg-3"
>
  <bdi data-presence="city">{from}</bdi>{' · '}<span data-presence="state" data-live-dot
    >{text.state}</span
  ><bdi data-presence="track">{text.track}</bdi><span data-presence="artist"
    >{text.artist}</span
  >
</p>

{/* Live, the state word takes --c-live after the live dot (global.css). */}
<style>
  [data-state="live"] [data-presence="state"] {
    color: var(--c-live);
  }
</style>
