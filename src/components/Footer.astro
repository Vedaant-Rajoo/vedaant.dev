---
import { day } from '../data/format';
import { built, resumeMonth, site } from '../data/site';
import Arrow from './Arrow.astro';

const updated = `${built.year}-${built.month}-${built.day}`;
---

<footer class="flex flex-col gap-2 border-t border-line pt-6 pb-12">
  <p class="-mx-1.5 flex flex-wrap gap-2 text-sm">
    <a href={`mailto:${site.email}`} class="box" data-copy>
      <span>email <Arrow>→</Arrow></span>
    </a>
    <a href="/resume.pdf" class="box">
      <span>résumé · <time datetime={site.resume.updated} class="text-xs">{resumeMonth}</time> <Arrow>↗</Arrow></span>
    </a>
    {
      Object.entries(site.socials).map(([name, href]) => (
        <a href={href} rel="me" class="box">
          <span>{name} <Arrow>↗</Arrow></span>
        </a>
      ))
    }
    <a href="/feed.xml" class="box"><span>rss</span></a>
  </p>
  {/* Links in this line keep its height (WCAG 2.5.8's inline exception). The Last.fm credit, which
      its terms ask for, covers the hero's presence line. */}
  <p class="meta text-xs text-fg-3">
    built with Astro · <a href={site.source} class="link">source <Arrow>↗</Arrow></a> · <a href="https://www.last.fm/" class="link">via last.fm <Arrow>↗</Arrow></a> · updated <time datetime={updated} class="whitespace-nowrap">{day(updated)}</time>
  </p>
  <span id="copy-status" class="sr-only" aria-live="polite"></span>
</footer>

<script>
  // With JS, a click on an email link copies the address instead of opening the mail
  // client, and the link reads "copied" for 1.5 s. A click with a modifier key, a browser without
  // the Clipboard API and a failed copy open the mailto: link as before.
  const status = document.getElementById('copy-status') as HTMLElement;
  let announcer: HTMLAnchorElement | undefined;
  for (const link of document.querySelectorAll<HTMLAnchorElement>('a[data-copy]')) {
    const address = decodeURIComponent(link.pathname);
    const text = link.firstElementChild as HTMLElement;
    const label = [...text.childNodes];
    let clicks = 0;
    let timer: ReturnType<typeof setTimeout> | undefined;
    link.addEventListener('click', (event) => {
      if (!navigator.clipboard || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
        return;
      }
      event.preventDefault();
      const click = ++clicks;
      navigator.clipboard.writeText(address).then(
        () => {
          // "copied" is narrower than "email →": the span keeps its width, so nothing moves.
          text.style.width = `${text.getBoundingClientRect().width}px`;
          text.textContent = 'copied';
          status.textContent = 'copied';
          announcer = link;
          clearTimeout(timer);
          timer = setTimeout(() => {
            text.replaceChildren(...label);
            text.style.width = '';
            // One region serves every link: only the link that wrote it last empties it.
            if (announcer === link) {
              status.textContent = '';
            }
          }, 1500);
        },
        () => {
          // A failed copy opens the mail client, unless a later click on this link replaced it.
          if (click === clicks) {
            location.href = link.href;
          }
        },
      );
    });
  }
</script>

<style>
  footer {
    margin-block-start: var(--sp-section);
  }
</style>
